# ---------------------------------------------------------------------------
# Everything here is optional. With none of it set the app runs in local-only
# mode: localStorage persistence, no cloud sync, no AI, no live market data.
# Copy to .env.local and fill in what you want.
# ---------------------------------------------------------------------------

# --- Cross-device sync (client-side, safe to expose) -----------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI features (server-side only — never prefixed VITE_) -----------------
# https://openrouter.ai/keys — key looks like sk-or-v1-...
OPENROUTER_API_KEY=
# Cheap + fast: answer grading, follow-up questions, hints.
OPENROUTER_MODEL_FAST=anthropic/claude-haiku-4.5
# Stronger: question generation, market explanations, batch content scripts.
OPENROUTER_MODEL_SMART=anthropic/claude-sonnet-5

# Same two values as above, read by /api/ai to verify the caller's session.
# Required in production; without them the AI route refuses every request.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Live market data (server-side only) -----------------------------------
# https://finnhub.io/register — free tier, ~60 req/min
FINNHUB_API_KEY=
# https://fredaccount.stlouisfed.org/apikeys — free
FRED_API_KEY=
